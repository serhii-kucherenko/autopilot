{
  "name": "autopilot",
  "private": true,
  "packageManager": "pnpm@10.2.0",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "typecheck": "pnpm -r --no-bail typecheck",
    "lint": "oxlint packages apps --deny-warnings",
    "test": "pnpm -r --no-bail test",
    "demo": "pnpm --filter @autopilot/console demo",
    "autopilot": "pnpm --filter @autopilot/core exec tsx src/cli.ts"
  },
  "devDependencies": {
    "oxlint": "^1.9.0",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3"
  }
}
