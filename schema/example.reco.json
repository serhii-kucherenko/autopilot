{
  "$schema": "./autopilot.config.schema.json",
  "product": {
    "name": "Reco",
    "vision": "docs/vision.md",
    "anchors": [
      "DESIGN.md",
      "CONTEXT.md",
      "docs/adr/",
      "docs/vision.md"
    ]
  },
  "tracker": {
    "kind": "linear",
    "project": "Reco",
    "team": "Core Team",
    "laneLabels": {
      "ai": "lane:ai",
      "human": "lane:human"
    }
  },
  "repo": {
    "root": ".",
    "defaultBranch": "main",
    "branchPrefix": "auto/"
  },
  "environments": {
    "staging": {
      "deploy": "RECOMP_ALLOW_PHYSICAL_IPAD=1 INSTALL_DEVICE=ipad bash ios/package-ios.sh"
    },
    "production": {
      "deploy": "bash ios/release.sh",
      "requiresHumanApproval": true
    }
  },
  "gate": {
    "commands": [
      "npm run lint",
      "npx tsc --noEmit",
      "npm test"
    ],
    "featureFlags": {
      "required": true,
      "defaultState": "off"
    }
  },
  "capture": {
    "loupe": {
      "enabled": true,
      "bundleDir": "~/.loupe/Reco"
    },
    "conversational": true
  },
  "boundaries": {
    "protectedPaths": [
      "ios/Secrets/",
      "**/.env*",
      "fastlane/match/",
      "public/pdfjs/",
      "ios/DerivedData*/"
    ],
    "forbiddenCommands": [
      "git push --force",
      "rm -rf"
    ],
    "maxTicketsInFlight": 1
  },
  "cadence": {
    "engineerInterval": "30m",
    "digest": "daily 08:00",
    "selfAuditOnEmptyBacklog": true
  }
}
